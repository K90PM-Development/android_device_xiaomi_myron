# eUICC
on post-fs-data && property:ro.boot.hwc=CN
    # CN Variant does not have eSIM
    mount none /dev/null /odm/overlay/MyronEuiccOverlay.apk bind
    mount none /dev/null /product/etc/permissions/android.hardware.telephony.euicc.mep.xml bind
    mount none /dev/null /product/etc/permissions/android.hardware.telephony.euicc.xml bind
    mount none /dev/null /product/etc/permissions/privapp-permissions-euiccgoogle.xml bind
    mount none /dev/null /product/priv-app/EuiccGoogle/EuiccGoogle.apk bind
    mount none /dev/null /system_ext/priv-app/XiaomiEsimSwitcher/XiaomiEsimSwitcher.apk bind
    mount none /dev/null /system_ext/priv-app/XiaomiEuicc/XiaomiEuicc.apk bind
    mount none /dev/null /vendor/etc/permissions/android.hardware.telephony.cdma.xml bind